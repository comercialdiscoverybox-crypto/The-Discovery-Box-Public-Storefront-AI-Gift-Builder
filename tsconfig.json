{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["storefront/**/*.ts", "storefront/**/*.tsx", "src/**/*.ts", "tests/**/*.ts"]
}
