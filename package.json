{
  "name": "the-discovery-box-public-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:storefront": "tsx storefront/server.ts",
    "build:storefront": "vite build --config storefront/vite.config.ts && esbuild storefront/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/storefront/server.cjs",
    "start:storefront": "node dist/storefront/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/storefront.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.115.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
